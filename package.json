{
  "name": "nand-craft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sim:snapshot": "node --import ./scripts/viteRawLoader.ts scripts/simCheck.ts --snapshot",
    "sim:check": "node --import ./scripts/viteRawLoader.ts scripts/simCheck.ts --check",
    "sim:scene": "node --import ./scripts/viteRawLoader.ts scripts/simCheck.ts --scene",
    "sim:bench": "node --import ./scripts/viteRawLoader.ts scripts/simCheck.ts --bench"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "@preact/signals": "^2.8.2",
    "preact": "^10.29.0"
  }
}
